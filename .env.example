# MSW 모킹 켜기(enabled)·끄기(disabled), 로컬·배포 모두 이 값으로 적용(백엔드 API 배포 후 배포 환경 값 제거)
NEXT_PUBLIC_API_MOCKING=

# 백엔드 GraphQL 엔드포인트 절대 주소(…/graphql), 토큰 재발급(/auth/reissue)도 같은 origin 사용
NEXT_PUBLIC_GRAPHQL_ENDPOINT=

# codegen용 스키마를 받을 개발 서버 GraphQL 주소(introspection 허용), pnpm schema:pull에서만 사용
GRAPHQL_SCHEMA_ENDPOINT=
